{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "lib": ["ES2017"],
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "skipLibCheck": true,
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"]
}
